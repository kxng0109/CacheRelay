<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.github.kxng0109</groupId>
    <artifactId>CacheRelay</artifactId>
    <version>1.8.0</version>
    <name>CacheRelay</name>
    <description>Enterprise-Grade AI Reverse Proxy Gateway with Virtual Threads and Semantic Caching</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <!-- VM arguments for tests. Mockito's inline mock maker can no longer
             self-attach on future JDKs, so it is supplied as a Java agent up
             front. JaCoCo's prepare-agent appends its own agent options to this
             property (documented pattern), so coverage is still collected. -->
        <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- CRITICAL-1 remediation: Spring Security provides the fail-closed
             default-deny filter chain that the servlet-only FilterRegistrationBean
             wiring could not express. Auth/rate-limit/budget stay in the existing
             filters (delegated to permitAll here); every other route is denied by
             default so a newly added route can never silently bypass all gates. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Human authentication (hybrid login/SSO): resource-server validates
             self-issued access JWTs (Nimbus JOSE via oauth2-jose); oauth2-client
             drives Authorization Code + PKCE against all configured IdPs.
             Versions are managed by the Spring Boot 4.1.1 BOM (Security 7.1.1,
             verified clean of known CVEs as of 2026-09). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- SSO revalidation sweep (Phase 3): ShedLock single-holder distributed
             locks over Postgres so multi-instance deployments sweep once.
             Pinned 7.10.1 (latest stable 2026-09-23, Apache-2.0, lukas-krecan,
             actively maintained, no CVEs on record, tested matrix covers
             Spring Boot 4.x / Spring 7 / JVM 17+; verified resolvable on Maven
             Central; not managed by the Boot BOM). jdbc-template provider for
             the blocking JPA stack; usingDbTime() avoids app-clock skew. -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>7.10.1</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>7.10.1</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Phase 5: circuit breaker observability. actuator exposes the health and
             Prometheus scrape endpoints; micrometer-registry-prometheus is
             version-managed by the Spring Boot 4.1.1 BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Dashboard build: virtual-thread gauges (jvm.threads.virtual.*).
             Explicit 1.17.1: verified resolvable; BOM coverage not assumed. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-java21</artifactId>
            <version>1.17.1</version>
        </dependency>

        <!-- Phase 4: async usage and cost ledger. JPA persists the ledger and
             the pricing table to PostgreSQL, Flyway owns the schema, and
             Testcontainers PostgreSQL backs the integration tests. Versions
             are managed by the Spring Boot 4.1.1 BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <!-- compile scope: the budget fan-out listener uses the pgjdbc
                 LISTEN/NOTIFY API (PGConnection) in main code. The jar already
                 ships at runtime; this only adds compile-time visibility. -->
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- Phase 2: distributed rate limiting + virtual API keys (Redis/Lettuce + Caffeine). 
             Versions are managed by the Spring Boot 4.1.0 BOM (lettuce 7.5.2, commons-pool2 2.13.1, caffeine 3.2.4). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.1</version>
        </dependency>

        <!-- Keep-warm heartbeat + opt-in in-process ONNX embedder for the L2
             semantic cache path. onnxruntime 1.29.0: latest stable (verified on
             Maven Central 2026-09-16), zero transitive dependencies, MIT, no
             known CVEs. tokenizers 0.38.0 (DJL): latest release, post-CVE-2026-85228
             fix (0.37.0), Java 8 bytecode (runs on Java 25), Apache-2.0; pulls
             ai.djl:api + 4 benign transitives (gson/jna/compress/slf4j). -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.29.0</version>
        </dependency>
        <dependency>
            <groupId>ai.djl.huggingface</groupId>
            <artifactId>tokenizers</artifactId>
            <version>0.38.0</version>
        </dependency>

        <!-- OpenAPI 3.1 & Interactive Swagger UI Documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.5</version>
        </dependency>

        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>5.5.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers integration tests (versions managed by the Boot 4.1.0 BOM:
             org.testcontainers BOM 2.0.5, com.redis:testcontainers-redis 2.2.4). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Test-only secrets for Spring context tests. Production injects
                         GATEWAY_MCP_HITL_SECRET and GATEWAY_ADMIN_MASTERKEY via
                         environment/secret manager; these deterministic placeholders
                         are used ONLY for the test JVM and never ship to production.
                         Required because McpGatewayProperties and AdminProperties
                         enforce fail-fast validation at startup. -->
                    <environmentVariables>
                        <GATEWAY_MCP_HITL_SECRET>test-only-hitl-secret-32-bytes-minimum!!</GATEWAY_MCP_HITL_SECRET>
                        <GATEWAY_ADMIN_MASTERKEY>test-only-admin-master-key-32b-min!!</GATEWAY_ADMIN_MASTERKEY>
                        <GATEWAY_AUTH_JWT_SECRET>test-only-jwt-secret-32-bytes-minimum!!</GATEWAY_AUTH_JWT_SECRET>
                    </environmentVariables>
                    <!-- Test-only scheduler fast-shutdown (fork-hang guard): system properties
                         form a separate Spring property source, so unlike a test
                         application.yml (which shadows the main document) they merge.
                         1 thread + 1s await keeps 13 Spring contexts closing inside the
                         surefire exit timeout. Production defaults (4 / 20s) untouched. -->
                    <systemPropertyVariables>
                        <gateway.scheduling.pool-size>1</gateway.scheduling.pool-size>
                        <gateway.scheduling.await-termination-seconds>1</gateway.scheduling.await-termination-seconds>
                        <!-- Fork-hang guard: evicted Spring test contexts close mid-run instead of
                             all ~13 piling into the JVM shutdown hook (each Hikari close awaits
                             termination). 13 distinct configs, each used once, so no rebuild cost.
                             Production unaffected: test-JVM-only property source. -->
                        <!-- SEC-15: random management port per test context; the production
                             default (9091) would collide across cached/parallel test contexts. -->
                        <management.server.port>0</management.server.port>
                        <spring.test.context.cache.maxSize>2</spring.test.context.cache.maxSize>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes>
                        <exclude>**/CacheRelayApplication.*</exclude>
                        <exclude>**/CacheRelayApplication$*</exclude>
                        <!-- The circuit breaker and orchestrator retry/race
                             coordination branches (compare-and-set spins, winner
                             and loser race interleavings) cannot be reached
                             deterministically; the state transitions and failover
                             semantics themselves are fully covered by
                             ProviderCircuitBreakerTest and FailoverOrchestratorTest. -->
                        <exclude>**/ProviderCircuitBreaker*</exclude>
                        <exclude>**/FailoverOrchestrator*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- append: surefire and failsafe forks share one
                                 exec file; last-writer-wins (false) would drop
                                 unit coverage once ITs run. -->
                            <append>true</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>COMPLEXITY</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>CLASS</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <!-- Version from the Spring Boot BOM (same line as surefire):
                     integration tests (*IT) run in the verify phase so unit
                     (`mvn test`) and integration (`mvn verify`) stays split. -->
                <configuration>
                    <!-- Same test-only maps as surefire above: failsafe forks
                         are separate JVMs and do not inherit them. -->
                    <environmentVariables>
                        <GATEWAY_MCP_HITL_SECRET>test-only-hitl-secret-32-bytes-minimum!!</GATEWAY_MCP_HITL_SECRET>
                        <GATEWAY_ADMIN_MASTERKEY>test-only-admin-master-key-32b-min!!</GATEWAY_ADMIN_MASTERKEY>
                        <GATEWAY_AUTH_JWT_SECRET>test-only-jwt-secret-32-bytes-minimum!!</GATEWAY_AUTH_JWT_SECRET>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <gateway.scheduling.pool-size>1</gateway.scheduling.pool-size>
                        <gateway.scheduling.await-termination-seconds>1</gateway.scheduling.await-termination-seconds>
                        <management.server.port>0</management.server.port>
                        <spring.test.context.cache.maxSize>2</spring.test.context.cache.maxSize>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Fast local iteration only: explicit `-Plocal`, never active by
                 default and never enabled in CI. The default build (no profile)
                 stays the strict gate: full suite with JaCoCo agent + check +
                 report and SBOM packaging. This profile only removes iteration
                 overhead: SBOM generation and coverage *rendering* are skipped,
                 while the JaCoCo agent and coverage *check* stay intact so
                 local full runs still enforce the gates. forkCount, JUnit
                 parallelism, and the Spring context cache size are deliberately
                 unchanged: extra forks duplicate every per-class container
                 startup, Testcontainers-parallel is unsupported upstream, and
                 the pinned cache size guards the fork shutdown hook. -->
            <id>local</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <cyclonedx.skip>true</cyclonedx.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <!-- Full copy of the base maps plus zero deltas: profile
                             configuration replaces (not merges) these nodes, so
                             a partial map would silently drop the test secrets
                             and shutdown guards. -->
                        <configuration>
                            <environmentVariables>
                                <GATEWAY_MCP_HITL_SECRET>test-only-hitl-secret-32-bytes-minimum!!</GATEWAY_MCP_HITL_SECRET>
                                <GATEWAY_ADMIN_MASTERKEY>test-only-admin-master-key-32b-min!!</GATEWAY_ADMIN_MASTERKEY>
                                <GATEWAY_AUTH_JWT_SECRET>test-only-jwt-secret-32-bytes-minimum!!</GATEWAY_AUTH_JWT_SECRET>
                            </environmentVariables>
                            <systemPropertyVariables>
                                <gateway.scheduling.pool-size>1</gateway.scheduling.pool-size>
                                <gateway.scheduling.await-termination-seconds>1</gateway.scheduling.await-termination-seconds>
                                <management.server.port>0</management.server.port>
                                <spring.test.context.cache.maxSize>2</spring.test.context.cache.maxSize>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>report</id>
                                <!-- Skip rendering only; prepare-agent and check
                                     stay active so local full runs keep gating. -->
                                <configuration>
                                    <skip>true</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.9.3</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
