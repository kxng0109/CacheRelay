      "targets": [
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le) (rate(sse_flush_duration_seconds_bucket[10m])))", "legendFormat": "Flush P50", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(sse_flush_duration_seconds_bucket[10m])))", "legendFormat": "Flush P95", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le) (rate(sse_flush_duration_seconds_bucket[10m])))", "legendFormat": "Flush P99", "range": true, "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(sse_stream_duration_seconds_bucket[10m])))", "legendFormat": "Stream lifetime P95", "range": true, "refId": "D" }
