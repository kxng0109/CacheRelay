      "targets": [{ "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum(rate(sse_flush_backpressure_count_total[$__rate_interval]))", "instant": true, "range": false, "refId": "A" }],
