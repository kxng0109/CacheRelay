{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "CacheRelay gateway: service health, request rate, errors, latency, budget/rate-limit truth, breaker state, and token economics. Legend names are explicit and non-repeating; health signals never fake zeros (absence renders as No data, never green).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Service Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Gateway scrape liveness (up{job=\"cacherelay\"}). Absence renders as No data, never a fake zero.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "DOWN" } }, "type": "value" },
            { "options": { "1": { "color": "green", "index": 1, "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "short", "noValue": "No data"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "noValue": "No data" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "up{job=\"cacherelay\"}", "instant": true, "range": false, "refId": "A" }],
      "title": "Gateway Up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "JVM process uptime since last start.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "s", "noValue": "No data"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "noValue": "No data" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "max without (instance) (process_uptime_seconds)", "instant": true, "range": false, "refId": "A" }],
      "title": "Uptime",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Requests per second across all HTTP endpoints (templated URI dimension).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "reqps", "decimals": 2, "noValue": "No data"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "noValue": "No data" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum(rate(http_server_requests_seconds_count[$__rate_interval]))", "instant": true, "range": false, "refId": "A" }],
      "title": "Requests/s",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "5xx responses as a percentage of all requests. Any value above zero is red — absence of the series renders as No data, never a green zero.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.001 }] },
          "unit": "percent", "decimals": 2, "noValue": "No data"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "noValue": "No data" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "100 * (sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[$__rate_interval])) > 0) / (sum(rate(http_server_requests_seconds_count[$__rate_interval])) > 0)", "instant": true, "range": false, "refId": "A" }],
      "title": "5xx Error %",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Requests blocked by the token-bucket rate limiter (429). Counts non-zero traffic only; absence renders as No data.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.001 }, { "color": "red", "value": 1 }] },
          "unit": "reqps", "decimals": 3, "noValue": "No data"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "noValue": "No data" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum(rate(http_server_requests_seconds_count{status=\"429\"}[$__rate_interval]))", "instant": true, "range": false, "refId": "A" }],
      "title": "Rate Limited 429/s",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Providers whose circuit breaker is OPEN (cacherelay_circuit_breaker_state == 1), by provider. Empty table below means all closed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short", "noValue": "All closed"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "noValue": "All closed" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "count(cacherelay_circuit_breaker_state == 1)", "instant": true, "range": false, "refId": "A" }],
      "title": "Open Breakers",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "panels": [],
      "title": "Request Performance (RED)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Latency percentiles from the http.server.requests histogram (templated URIs only). P99 is computed over a 5m window to stay stable at low traffic.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 6, "showPoints": "never", "spanNulls": true },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.25 }, { "color": "red", "value": 0.5 }] },
          "unit": "s", "min": 0, "noValue": "No data"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "P50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "P95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "P99" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket[$__rate_interval])))", "legendFormat": "P50", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[$__rate_interval])))", "legendFormat": "P95", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "P99", "range": true, "refId": "C" }
      ],
      "title": "Latency P50 / P95 / P99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Request rate split by HTTP status class, derived from the templated URI dimension.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true, "stacking": { "mode": "normal", "group": "A" } },
          "mappings": [], "unit": "reqps", "min": 0, "noValue": "No data"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum by (outcome) (rate(http_server_requests_seconds_count{outcome=~\"SUCCESS|REDIRECTION\"}[$__rate_interval]))", "legendFormat": "{{outcome}}", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum by (outcome) (rate(http_server_requests_seconds_count{outcome=~\"CLIENT_ERROR|SERVER_ERROR\"}[$__rate_interval]))", "legendFormat": "{{outcome}}", "range": true, "refId": "B" }
      ],
      "title": "Request Rate by Outcome",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "panels": [],
      "title": "Admission: Rate Limits & Budgets",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Rate-limit evaluations per second by decision. NOTE: one evaluation per chat / embedding / MCP-call / A2A-message request; models, admin, auth, and health paths never evaluate by design (unmetered). At idle traffic, flat zero is correct.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "mappings": [], "unit": "ops", "min": 0, "noValue": "No data"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Allowed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Denied (429)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 16 },
      "id": 20,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum(rate(cacherelay_ratelimit_evaluations_total{decision=\"allowed\"}[$__rate_interval]))", "legendFormat": "Allowed", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum(rate(cacherelay_ratelimit_evaluations_total{decision=\"denied\"}[$__rate_interval]))", "legendFormat": "Denied (429)", "range": true, "refId": "B" }
      ],
      "title": "Rate-Limit Evaluations by Decision",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Denied evaluations as a percentage of all evaluations, with a minimum-sample guard so idle traffic cannot paint a meaningful 0%. Matches the RateLimitDenySpike alert at 5%.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "green", "value": 1 }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] },
          "unit": "percent", "decimals": 1, "noValue": "No data"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 16 },
      "id": 21,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "noValue": "No data" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "100 * sum(rate(cacherelay_ratelimit_evaluations_total{decision=\"denied\"}[$__rate_interval])) / clamp_min(sum(rate(cacherelay_ratelimit_evaluations_total[$__rate_interval])), 0.01) and sum(increase(cacherelay_ratelimit_evaluations_total[$__rate_interval])) >= 10", "instant": true, "range": false, "refId": "A" }
      ],
      "title": "Deny Rate % (min 10 evals)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Budget admission evaluations by decision. The series renders No data until the gateway emits cacherelay_budget_evaluations_total with a decision label.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "mappings": [], "unit": "ops", "min": 0, "noValue": "No data"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 16 },
      "id": 22,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum by (decision) (rate(cacherelay_budget_evaluations_total[$__rate_interval]))", "legendFormat": "{{decision}}", "range": true, "refId": "A" }
      ],
      "title": "Budget Evaluations by Decision",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "panels": [],
      "title": "LLM Token Economics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Token generation rate by model and direction, straight from cacherelay_tokens_total.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "mappings": [], "unit": "ops", "min": 0, "noValue": "No data"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 30,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum by (model, provider, type) (rate(cacherelay_tokens_total[$__rate_interval]))", "legendFormat": "{{provider}} · {{model}} · {{type}}", "range": true, "refId": "A" }
      ],
      "title": "Token Rate by Provider / Model / Type",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Cache lookups by hit level. hit_l0 = exact, hit_l1 = semantic layer, miss = upstream call. Absence of all hits renders No data; it is never replaced with a fabricated zero.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "mappings": [], "unit": "ops", "min": 0, "noValue": "No data"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Exact hit (L0)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Semantic hit (L1)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "Miss (upstream)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 31,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum(rate(cacherelay_cache_requests_total{status=\"hit_l0\"}[$__rate_interval]))", "legendFormat": "Exact hit (L0)", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum(rate(cacherelay_cache_requests_total{status=\"hit_l1\"}[$__rate_interval]))", "legendFormat": "Semantic hit (L1)", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum(rate(cacherelay_cache_requests_total{status=\"miss\"}[$__rate_interval]))", "legendFormat": "Miss (upstream)", "range": true, "refId": "C" }
      ],
      "title": "Cache Lookups by Level",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
