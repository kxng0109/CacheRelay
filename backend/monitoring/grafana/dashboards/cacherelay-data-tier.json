      "targets": [{ "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum by (tier) (rate(redis_commands_processed_total[$__rate_interval]))", "legendFormat": "{{tier}} ops/s", "range": true, "refId": "A" }],
