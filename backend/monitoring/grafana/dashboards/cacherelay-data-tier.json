      "targets": [{ "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" }, "editorMode": "code", "expr": "sum by (tier) (rate(redis_cpu_user_main_thread_seconds_total[$__rate_interval])) + sum by (tier) (rate(redis_cpu_sys_main_thread_seconds_total[$__rate_interval]))", "legendFormat": "{{tier}}", "instant": true, "range": false, "refId": "A" }],
      "title": "Redis Main-Thread CPU by Tier",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "cacherelay-prometheus" },
      "description": "Commands processed per second per tier. Accounting carries rate limits, budgets, holds, dedupe, and breakers; cache carries lookups and vectors.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "mappings": [], "unit": "ops", "min": 0, "decimals": 3, "noValue": "No data"
