    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-router": "7.18.3",
    "web-vitals": "6.2.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
