# CacheRelay frontend — public, non-secret client config template.
# Copy to `.env.local` (gitignored) for local overrides. Never commit secrets here:
# no tokens, keys, passwords, or private identifiers. VITE_* values are
# build-time-inlined into the client bundle and visible to every visitor.

# Gateway base URL (no trailing slash). Dev default: local Spring gateway.
# Contract: backend/docs/BACKEND_API_REFERENCE.md A0 (default port 8080).
VITE_API_BASE_URL=http://localhost:8080

# Management base URL for actuator scrapes (health, prometheus; no trailing
# slash). Dev default: SEC-15 management port 9091 — the app port answers
# every /actuator/** path with 404. Non-secret client config.
VITE_MANAGEMENT_BASE_URL=http://localhost:9091

# Enables SSE streaming paths (`text/event-stream`, terminal `data: [DONE]`).
# Set to `false` to force non-streaming JSON completions only.
VITE_FEATURE_STREAMING=true

# SSO providers (comma-separated Spring registration ids, e.g.
# `google,github,okta`). Empty or unset greys SSO out with "SSO not
# enabled" — SSO cannot run unless the backend configured it
# (`SSO_*_CLIENT_ID`). Non-secret client config.
VITE_SSO_PROVIDERS=
