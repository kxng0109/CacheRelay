# CacheRelay frontend — public, non-secret client config template.
# Copy to `.env.local` (gitignored) for local overrides. Never commit secrets here:
# no tokens, keys, passwords, or private identifiers. VITE_* values are
# build-time-inlined into the client bundle and visible to every visitor.

# Gateway base URL (no trailing slash). Dev default: local Spring gateway.
# Contract: backend/docs/BACKEND_API_REFERENCE.md §0 (default port 8080).
VITE_API_BASE_URL=http://localhost:8080

# Enables SSE streaming paths (`text/event-stream`, terminal `data: [DONE]`).
# Set to `false` to force non-streaming JSON completions only.
VITE_FEATURE_STREAMING=true
