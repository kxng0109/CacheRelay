# -----------------------------------------------------------------------------
# CacheRelay Docker Compose Configuration Template
# Do NOT copy this manually: run the bootstrap, which fills every required secret
# with a locally generated random value (no external tools, no paid services):
#   Windows:        scripts\init-env.cmd
#   macOS / Linux:  ./scripts/init-env.sh
# It creates .env next to this file. Provider API keys stay blank: the gateway
# boots without them, and the free local model path is Ollama (see OLLAMA_BASE_URL).
# -----------------------------------------------------------------------------

# Ports
GATEWAY_PORT=8080
# SEC-15: actuator (health + prometheus) management port, published on host loopback
# only (never on GATEWAY_BIND_HOST). Prometheus scrapes it over the compose network.
GATEWAY_MANAGEMENT_PORT=9091
# Gateway bind host. 127.0.0.1 (default) keeps the gateway - and the PUBLIC dev bootstrap keys
# below - unreachable from the network. Set 0.0.0.0 ONLY behind a firewall/LB with rotated keys.
GATEWAY_BIND_HOST=127.0.0.1
REDIS_PORT=6379
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Observability & Monitoring (Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cacherelay_secret
GRAFANA_AUTH_ANONYMOUS_ENABLED=true

# PostgreSQL Configuration (SEC-12: POSTGRES_PASSWORD is hard-required with no default;
# scram-sha-256 enforced. Generate with: openssl rand -hex 32)
POSTGRES_DB=cacherelay
POSTGRES_USER=cacherelay
POSTGRES_PASSWORD=
# Least-privilege user for postgres-exporter (pg_monitor member, created once
# via: CREATE USER ... + GRANT pg_monitor). Filled by scripts/init-env.* (compose
# refuses to start while blank).
POSTGRES_EXPORTER_USER=cacherelay_exporter
POSTGRES_EXPORTER_PASSWORD=

# Upstream Provider Keys (insert your real provider API keys here).
# A provider stays inert until its key is set AND an alias chain references it
# (file config or POST /v1/admin/models). All are OpenAI-compatible: no Java
# changes needed. Qwen/Cloudflare/Bedrock also need their base URL/account vars.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
DEEPINFRA_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NEBIUS_API_KEY=
NOVITA_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=
STEP_API_KEY=
CLOUDFLARE_API_TOKEN=
HYPERBOLIC_API_KEY=
IO_API_KEY=
FRIENDLI_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
VLLM_API_KEY=
LLAMACPP_API_KEY=
LMSTUDIO_API_KEY=
# Qwen base URL: https://{WorkspaceId}.{region}.maas.aliyuncs.com/compatible-mode/v1
# (intl legacy: https://dashscope-intl.aliyuncs.com/compatible-mode/v1).
QWEN_BASE_URL=
# Cloudflare account ID embedded in the Workers AI base URL.
CLOUDFLARE_ACCOUNT_ID=
# AWS Bedrock OpenAI-compatible base URL, e.g.
# https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1 (SigV4 needs a native adapter).
AWS_BEDROCK_BASE_URL=

# Master Admin Key (required for /v1/admin/** management endpoints).
# SEC-03: no default — the app fails fast at startup when this is missing, blank,
# shorter than 32 bytes, or a published default. Filled by scripts/init-env.* (hex, 32 bytes).
GATEWAY_ADMIN_MASTERKEY=

# SSRF allowlist for local development backends (exact hostnames only, comma
# separated; e.g. localhost,host.docker.internal). Empty by default: every private
# address target fails closed. Add ONLY explicitly-trusted development hosts here.
GATEWAY_DEV_ALLOW_PRIVATE_HOSTS=localhost,host.docker.internal

# HITL AEAD secret (REQUIRED — 32+ bytes; the app refuses to start without it).
# Filled by scripts/init-env.* (hex, 32 bytes).
GATEWAY_MCP_HITL_SECRET=

# Spring profile: default serves light/moderate load; "high-throughput" unlocks
# the 100K rps / 50K-stream ceilings (needs tuned Redis/PG per docs/high-throughput/)
SPRING_PROFILES_ACTIVE=default

# Redis (compose service; shared native connection — no pool keys, see application.yml)
# SEC-12: both tiers enforce requirepass with DISTINCT hard-required secrets.
# Generate each with: openssl rand -hex 32
REDIS_PASSWORD=
REDIS_CACHE_PASSWORD=

# Human-auth JWT HMAC secret: 32+ bytes, MANDATORY outside the dev profile
# (startup fails without a stable secret; generate with: openssl rand -base64 32).
# Blank mints an ephemeral secret under dev/test only (restart-invalid).
GATEWAY_AUTH_JWT_SECRET=

# PostgreSQL pool (compose service)
HIKARI_MAXIMUM_POOL_SIZE=10
HIKARI_MINIMUM_IDLE=10

# Local Ollama (host gateway). Containers cannot reach the host's localhost:11434
# directly; point at the host gateway (Ollama needs no network-access toggle).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Capacity ceilings (defaults serve light/moderate load; see .env.example for all)
CACHERELAY_SSE_CAPACITY_MAX_CONNECTIONS=10000
GATEWAY_LEDGER_EXECUTOR_CORE_POOL_SIZE=2
GATEWAY_LEDGER_EXECUTOR_MAX_POOL_SIZE=4
GATEWAY_LEDGER_EXECUTOR_QUEUE_CAPACITY=1000
GATEWAY_RATELIMIT_KEY_CACHE_MAXIMUM_SIZE=1000
GATEWAY_RATELIMIT_WINDOW_MILLIS=60000

# Semantic (L2) cache embedding alias. Resolved via gateway.providers/aliases
# like any other request; default local-embed works on the local Ollama stack.
# Set to text-embedding-3-small (or any alias) for a different embedding model.
GATEWAY_CACHE_SEMANTIC_EMBEDDING_MODEL=local-embed

# Container FD limits
ULIMIT_NOFILE_SOFT=65536
ULIMIT_NOFILE_HARD=100000

# Local Development Bootstrap Key (pre-seeded virtual key for instant curl requests)
# Must start with gw- followed by 32 base64url characters (key is rejected otherwise)
# PUBLIC by design (documented in the README): safe only while GATEWAY_BIND_HOST stays 127.0.0.1.
GATEWAY_BOOTSTRAPKEYS_0_OWNERID=local
GATEWAY_BOOTSTRAPKEYS_0_NAME=local-dev
GATEWAY_BOOTSTRAPKEYS_0_PLAINTEXTKEY=gw-localdevmasterkey0123456789abcde
GATEWAY_BOOTSTRAPKEYS_0_RPMLIMIT=120
GATEWAY_BOOTSTRAPKEYS_0_TPMLIMIT=500000
GATEWAY_BOOTSTRAPKEYS_0_ALLOWEDMODELS=
GATEWAY_BOOTSTRAPKEYS_0_ALLOWEDPROVIDERS=
# Cache isolation scopes for the key (SEC-01; comma-separated TENANT/USER/GLOBAL, default TENANT-only).
# GLOBAL additionally requires GATEWAY_CACHE_GLOBAL_SCOPE_ENABLED=true.
GATEWAY_BOOTSTRAPKEYS_0_ALLOWEDCACHESCOPES=

# Load-Test Bootstrap Key (high RPM ceiling so k6 floods are NOT rate-limited;
# set LOAD_KEY=gw-0123456789abcdef0123456789abcdef in the k6 env to use it).
# 60000 RPM covers the 500 rps flood (30K req/min) with headroom; kept separate
# from the 120 RPM dev key so rate-integrity stays observable.
GATEWAY_BOOTSTRAPKEYS_1_OWNERID=load
GATEWAY_BOOTSTRAPKEYS_1_NAME=load-test
GATEWAY_BOOTSTRAPKEYS_1_PLAINTEXTKEY=gw-0123456789abcdef0123456789abcdef
GATEWAY_BOOTSTRAPKEYS_1_RPMLIMIT=60000
GATEWAY_BOOTSTRAPKEYS_1_TPMLIMIT=10000000
